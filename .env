# ==========================================
# 拼多多 V2.0 客服引擎环境配置
# ==========================================

# 1. 缓存与存储底盘 (必须启动服务)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456

QDRANT_HOST=localhost
QDRANT_PORT=6333

# 2. V2.0 本地大脑引擎配置 (vLLM / Ollama)
# ⚠️ 注意：如果你用的是 Ollama 跑 Qwen2.5-7B，API 格式通常是兼容 OpenAI 的
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=customer-service:latest

# 3. 兜底云端大脑配置 (如需接入 GLM-4 等)
# CLOUD_LLM_API_BASE=http://67.230.168.254:8080
# CLOUD_LLM_API_KEY=sk-e15ff78aae4f5229e1c776796762eac10c054655203b1fada4bc0975e2444a21

# 4. 业务时间配置
BUSINESS_START_TIME=08:30
BUSINESS_END_TIME=23:30

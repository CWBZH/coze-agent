# customer-agent-refactor-v3 environment example
# Copy this file to .env for local use. Never commit .env with real secrets.

# -----------------------------
# 1. Base environment
# -----------------------------
# Runtime environment. Windows local example: local. Linux compose example: production.
APP_ENV=local

# Log verbosity. Windows local example: INFO. Linux compose example: INFO or WARNING.
LOG_LEVEL=INFO

# Enable headless mode for future Linux worker delivery. Current PyQt local default: 0.
HEADLESS_MODE=0

# -----------------------------
# 2. Data directories
# -----------------------------
# Root data directory. Windows local example: ./temp. Linux compose example: /app/data.
DATA_DIR=./temp

# Log directory. Windows local example: ./logs. Linux compose example: /app/logs.
LOG_DIR=./logs

# Cache directory. Windows local example: ./temp/cache. Linux compose example: /app/cache.
CACHE_DIR=./temp/cache

# Export directory. Windows local example: ./temp/export. Linux compose example: /app/export.
EXPORT_DIR=./temp/export

# SQLite database path. Windows local example: ./temp/channel_shop.db. Linux compose example: /app/data/channel_shop.db.
DB_PATH=./temp/channel_shop.db

# -----------------------------
# 3. Redis
# -----------------------------
# Redis host. Windows local example: localhost. Linux compose example: redis.
REDIS_HOST=localhost

# Redis port. Windows local and Linux compose default: 6379.
REDIS_PORT=6379

# Redis password. Replace before deployment.
REDIS_PASSWORD=change-me

# Redis database index. Default: 0.
REDIS_DB=0

# -----------------------------
# 4. FastGPT
# -----------------------------
# FastGPT base URL. Windows local example: http://localhost:3000/api. Linux compose example: http://fastgpt:3000/api.
FASTGPT_BASE_URL=http://localhost:3000/api

# FastGPT API key. Sensitive. Fill only in local .env or deployment secret.
FASTGPT_API_KEY=your-fastgpt-api-key

# FastGPT application id, reserved for Linux delivery or future config loading.
FASTGPT_APP_ID=your-fastgpt-app-id

# -----------------------------
# 5. Ollama / Proxy / Doubao
# -----------------------------
# Ollama OpenAI-compatible base URL, reserved for Linux delivery.
OLLAMA_BASE_URL=http://localhost:11434

# Proxy base URL. Windows local example: http://127.0.0.1:11435. Linux compose example: http://ollama-proxy:11435.
PROXY_BASE_URL=http://127.0.0.1:11435

# Proxy bind host, reserved for Linux delivery.
PROXY_BIND_HOST=127.0.0.1

# Proxy bind port, reserved for Linux delivery.
PROXY_PORT=11435

# LLM OpenAI-compatible base URL. Windows local and Linux example for Doubao Ark.
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# LLM API key. Sensitive. Fill only in local .env or deployment secret.
LLM_API_KEY=your-llm-api-key

# LLM model name for local configuration UI and handlers.
LLM_MODEL_NAME=doubao-seed-2-0-mini-260215

# Doubao Authorization header. Optional if code builds Bearer from LLM_API_KEY.
DOUBAO_AUTH=Bearer your-doubao-token

# -----------------------------
# 6. Session compression model
# -----------------------------
# Session compression model name.
SESSION_COMPRESS_MODEL=doubao-seed-2-0-mini-260215

# Session compression OpenAI-compatible endpoint. Windows local example: http://host.docker.internal:11435. Linux compose example: http://ollama-proxy:11435.
SESSION_COMPRESS_BASE_URL=http://host.docker.internal:11435

# Session compression API key. Sensitive if required by proxy or provider.
SESSION_COMPRESS_API_KEY=your-session-compress-api-key

# Session compression timeout in seconds.
SESSION_COMPRESS_TIMEOUT=20

# Session compression max output tokens.
SESSION_COMPRESS_MAX_TOKENS=80

# Session compression temperature.
SESSION_COMPRESS_TEMPERATURE=0.3

# -----------------------------
# 7. Playwright / browser
# -----------------------------
# Playwright browser path. Windows local example: ./.browsers. Linux compose example: /ms-playwright.
PLAYWRIGHT_BROWSERS_PATH=./.browsers

# Browser cache directory, reserved for Linux delivery.
BROWSER_CACHE_DIR=./.browsers

# -----------------------------
# 8. Worker / runtime
# -----------------------------
# Consumer worker count, reserved for centralized config loading.
WORKER_CONCURRENCY=10

# Message queue max size, reserved for Linux delivery.
MESSAGE_QUEUE_MAX_SIZE=1000

# Reconnect max attempts, reserved for centralized config loading.
RECONNECT_MAX_ATTEMPTS=10

# Reconnect initial delay in seconds, reserved for centralized config loading.
RECONNECT_INITIAL_DELAY=1

# Reconnect max delay in seconds, reserved for centralized config loading.
RECONNECT_MAX_DELAY=60

# WebSocket heartbeat interval in seconds, reserved for centralized config loading.
HEARTBEAT_INTERVAL=30

# Auto-reply reconnect suspend TTL in seconds.
AUTO_REPLY_RECONNECT_SUSPEND_TTL=900

# Human lock TTL in seconds.
HUMAN_LOCK_TTL=240

# Inference lock TTL in seconds.
INFERENCE_LOCK_TTL=10

# Intent cache TTL in seconds.
INTENT_CACHE_TTL=600

# Alert cooldown TTL in seconds.
ALERT_COOLDOWN_TTL=60

# AI awakening TTL in seconds.
AI_AWAKENING_TTL=30

# Pending human TTL in seconds.
PENDING_HUMAN_TTL=300

# Fallback second reminder threshold before expiry in seconds.
FALLBACK_SECOND_REMINDER_BEFORE_EXPIRY=60

# Short sentence threshold for intent logic.
SHORT_SENTENCE_THRESHOLD=5

# -----------------------------
# 9. API service
# -----------------------------
# Customer agent API bind host, reserved for Linux delivery.
CUSTOMER_AGENT_API_HOST=0.0.0.0

# Customer agent API bind port, reserved for Linux delivery.
CUSTOMER_AGENT_API_PORT=8000

# -----------------------------
# 10. Notifications
# -----------------------------
# Enable PushPlus notification.
PUSHPLUS_ENABLED=false

# PushPlus token. Sensitive.
PUSHPLUS_TOKEN=your-pushplus-token

# PushPlus topic, reserved if topic routing is enabled.
PUSHPLUS_TOPIC=your-pushplus-topic

# PushPlus channel. Current default is clawbot.
PUSHPLUS_CHANNEL=clawbot

# PushPlus message template.
PUSHPLUS_TEMPLATE=txt

# PushPlus timeout in seconds.
PUSHPLUS_TIMEOUT=8

# -----------------------------
# 11. Database / external services for Linux delivery
# -----------------------------
# PostgreSQL host, reserved for Linux delivery.
POSTGRES_HOST=postgres

# PostgreSQL port, reserved for Linux delivery.
POSTGRES_PORT=5432

# PostgreSQL user, reserved for Linux delivery.
POSTGRES_USER=customer_agent

# PostgreSQL password. Sensitive and reserved for Linux delivery.
POSTGRES_PASSWORD=change-me

# PostgreSQL database name, reserved for Linux delivery.
POSTGRES_DB=customer_agent

# MongoDB connection string, reserved for FastGPT compose dependency.
MONGO_URL=mongodb://mongo:27017/fastgpt

# MinIO endpoint, reserved for FastGPT compose dependency.
MINIO_ENDPOINT=http://minio:9000

# MinIO access key. Sensitive and reserved for FastGPT compose dependency.
MINIO_ACCESS_KEY=change-me

# MinIO secret key. Sensitive and reserved for FastGPT compose dependency.
MINIO_SECRET_KEY=change-me
